# Copy to .env (never commit it) or set these on your host.

# Developer Portal → your application → Bot → Reset Token.
DISCORD_TOKEN=

# Any Postgres. For Supabase: Project Settings → Database → Connection string
# (use the "Session pooler" one if your host has no IPv6).
DATABASE_URL=postgres://user:password@host:5432/postgres

# Optional: the database's CA certificate, to connect over verified TLS.
# Supabase: Project Settings → Database → SSL Configuration → Download certificate.
# DATABASE_CA_FILE=./prod-ca-2021.crt

# Optional, for testing: register commands on this one server only. They show
# up instantly there, instead of globally. Remove it to go public.
# DEV_GUILD_ID=

# Optional: "false" skips re-registering commands on every start.
# REGISTER_COMMANDS=true

# Tests only: a database the tests may create and drop schemas in.
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/raidbot_test
